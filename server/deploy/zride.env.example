# Install as /etc/zride/zride.env, root:root 0600. Never commit real values.
HOST=0.0.0.0
PORT=8000
ZRIDE_DB_PATH=/var/lib/zride/zride.sqlite
# Required for Internet team tests. Empty permits guest enrollment (local fixtures only).
# Send privately; distinct from the observer key. Never put actual keys in source/URLs/logs.
ZRIDE_TEST_ACCESS_KEY=
# Empty disables the optional cross-room operator credential. Generate locally.
ZRIDE_OBSERVER_TOKEN=
