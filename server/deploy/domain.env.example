# DNS/TLS is managed by the separate personal-project session. Do not apply until ready.
# Preserve existing private keys and DB/catalog paths when merging these settings.
HOST=127.0.0.1
PORT=8000
ZRIDE_PUBLIC_ORIGIN=https://api.hjpark.net
ZRIDE_PHONE_PUBLIC_URL=https://play.hjpark.net/
ZRIDE_BROWSER_API_ORIGIN=https://api.hjpark.net
ZRIDE_ALLOWED_ORIGINS=https://play.hjpark.net
# Observer uses its own explicitly allowed origins and its own credential.
ZRIDE_OBSERVER_ALLOWED_ORIGINS=https://play.hjpark.net
# Exact direct proxy peer addresses only. Never trust arbitrary forwarded headers.
ZRIDE_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# Party pickup respawn, server milliseconds (1000..3600000).
ZRIDE_PICKUP_RESPAWN_MS=300000
