# DNS/TLS is managed by the separate personal-project session. Do not apply until ready.
# Preserve existing private keys and DB/catalog paths when merging these settings.
HOST=127.0.0.1
PORT=8000
ZRIDE_PUBLIC_ORIGIN=https://api.hjpark.net
ZRIDE_PHONE_PUBLIC_URL=https://play.hjpark.net/
ZRIDE_BROWSER_API_ORIGIN=https://api.hjpark.net
ZRIDE_ALLOWED_ORIGINS=https://play.hjpark.net
# Observer uses its own explicitly allowed origins and its own credential.
ZRIDE_OBSERVER_ALLOWED_ORIGINS=https://play.hjpark.net
# Exact direct proxy peer addresses only. Never trust arbitrary forwarded headers.
ZRIDE_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# Party pickup respawn, server milliseconds (1000..3600000).
ZRIDE_PICKUP_RESPAWN_MS=300000

# Event cycles and demo party supplies (independent of pickup respawn).
ZRIDE_EVENT_DURATION_MS=1800000
ZRIDE_EVENT_RESPAWN_MS=300000
ZRIDE_EVENT_TARGET_PARTIES=3
ZRIDE_MISSION_REWARD_SUPPLIES=1
ZRIDE_SHARED_REWARD_SUPPLIES=2

# Brand-independent names (GAME_* wins over existing ZRIDE_* aliases).
GAME_DISPLAY_NAME=Z-RIDE
# Enable only after the separate DNS/TLS deployment is ready:
# GAME_PUBLIC_ORIGIN=https://api.example.com
# GAME_PHONE_JOIN_URL=https://play.example.com/join
# GAME_BROWSER_API_ORIGIN=https://api.example.com
# GAME_ALLOWED_ORIGINS=https://play.example.com
# GAME_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# Google Cloud is not configured. Empty keeps Google phone login disabled.
GAME_GOOGLE_CLIENT_ID=
# Account tokens and verified Google ID tokens must never be logged.
