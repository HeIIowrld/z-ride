{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Z-RIDE place catalogue shard",
  "type": "array",
  "minItems": 1,
  "maxItems": 5000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "category",
      "latitude",
      "longitude",
      "region",
      "address",
      "theme",
      "facts",
      "unnamed",
      "osmModifiedAt",
      "sourceUrl",
      "reviewStatus",
      "gameEnabled",
      "displayCategory",
      "carAccess",
      "accessTags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(node|way|relation)/[1-9][0-9]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "enum": [
          "attraction",
          "parking",
          "charging_station",
          "fuel_station"
        ]
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "region": {
        "type": "string",
        "minLength": 1
      },
      "address": {
        "type": "string"
      },
      "theme": {
        "enum": [
          "forest",
          "water",
          "heritage",
          "city",
          "supply"
        ]
      },
      "facts": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "unnamed": {
        "type": "boolean"
      },
      "osmModifiedAt": {
        "type": "string",
        "format": "date-time"
      },
      "sourceUrl": {
        "type": "string",
        "pattern": "^https://www\\.openstreetmap\\.org/(node|way|relation)/[1-9][0-9]*$"
      },
      "reviewStatus": {
        "const": "pending"
      },
      "gameEnabled": {
        "const": false
      },
      "displayCategory": {
        "enum": [
          "nature",
          "waterfront",
          "heritage",
          "culture",
          "leisure",
          "religion",
          "attraction",
          "parking",
          "charging_station",
          "fuel_station"
        ]
      },
      "carAccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason",
          "evidence",
          "routeVerified"
        ],
        "properties": {
          "status": {
            "enum": [
              "unknown",
              "restricted_by_tag",
              "allowed_by_tag"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "routeVerified": {
            "const": false
          }
        }
      },
      "accessTags": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotAt",
          "matched",
          "tags"
        ],
        "properties": {
          "snapshotAt": {
            "type": "string",
            "format": "date-time"
          },
          "matched": {
            "type": "boolean"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
